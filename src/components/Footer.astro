---
import { SITE } from '@/lib/utils';
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-900 text-slate-300 dark:border-slate-800">
  <div class="container-wide section-padding !py-12">
    <div class="grid gap-10 md:grid-cols-4">
      <div class="md:col-span-2">
        <p class="font-display text-xl font-bold text-white">{SITE.displayName}</p>
        <p class="mt-1 text-xs text-slate-500">{SITE.name}</p>
        <p class="mt-2 max-w-md text-sm text-slate-400">{SITE.tagline}</p>
      </div>
      <div>
        <p class="text-sm font-semibold text-white">Learn</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/learn" class="hover:text-white">Study Material</a></li>
          <li><a href="/#paths" class="hover:text-white">Learning Paths</a></li>
          <li><a href="/pricing" class="hover:text-white">Pricing</a></li>
        </ul>
      </div>
      <div>
        <p class="text-sm font-semibold text-white">Connect</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={SITE.youtubeUrl} class="hover:text-white" target="_blank" rel="noopener noreferrer">YouTube</a></li>
          <li><a href="/pricing" class="hover:text-white">Pro & Cohort</a></li>
        </ul>
      </div>
    </div>
    <p class="mt-10 border-t border-slate-800 pt-6 text-center text-xs text-slate-500">
      © {year} {SITE.name}. Not affiliated with Google, Meta, Amazon, or other trademark holders.
    </p>
  </div>
</footer>
