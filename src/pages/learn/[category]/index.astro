---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CategoryTopicList } from '@/components/react/CategoryTopicList';
import { categories, getCategory } from '@/data/catalog';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { category: c.slug } }));
}

const { category: categorySlug } = Astro.params;
const category = getCategory(categorySlug!);

if (!category) {
  return Astro.redirect('/learn');
}

const freeCount = category.topics.filter((t) => t.isFree).length;
---

<BaseLayout title={category.title} description={category.description}>
  <section class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/50">
    <div class="container-wide section-padding !pb-8">
      <nav class="text-sm text-slate-500">
        <a href="/learn" class="hover:text-brand-600">Study Material</a>
        <span class="mx-2">/</span>
        <span class="text-slate-800 dark:text-slate-200">{category.title}</span>
      </nav>
      <div class={`mt-4 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br ${category.color} text-lg font-bold text-white`}>
        {category.title.charAt(0)}
      </div>
      <h1 class="mt-4 font-display text-3xl font-bold">{category.title}</h1>
      <p class="mt-2 max-w-2xl text-slate-600 dark:text-slate-400">{category.description}</p>
      <div class="mt-4 flex gap-2 text-xs">
        <span class="rounded-full bg-emerald-100 px-3 py-1 font-semibold text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300">
          {freeCount} free lessons
        </span>
        <span class="rounded-full bg-amber-100 px-3 py-1 font-semibold text-amber-800 dark:bg-amber-500/20 dark:text-amber-300">
          {category.topics.length - freeCount} premium
        </span>
      </div>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-wide grid gap-8 lg:grid-cols-4">
      <aside class="lg:col-span-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Tracks</p>
        <ul class="mt-3 space-y-1">
          {categories.map((c) => (
            <li>
              <a
                href={`/learn/${c.slug}`}
                class:list={[
                  'block rounded-lg px-3 py-2 text-sm font-medium transition',
                  c.slug === category.slug
                    ? 'bg-brand-50 text-brand-700 dark:bg-blue-500/10 dark:text-blue-300'
                    : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800',
                ]}
              >
                {c.title}
              </a>
            </li>
          ))}
        </ul>
      </aside>
      <div class="lg:col-span-3 rounded-2xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
        <div class="border-b border-slate-200 px-4 py-4 dark:border-slate-800 sm:px-6">
          <h2 class="font-display font-bold">Course outline</h2>
          <p class="text-sm text-slate-500">Start with free lessons — upgrade to unlock premium topics</p>
        </div>
        <CategoryTopicList client:load category={category} />
      </div>
    </div>
  </section>
</BaseLayout>
