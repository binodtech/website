---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CourseExplorer } from '@/components/react/CourseExplorer';
import { categories, getCategory } from '@/data/catalog';

export function getStaticPaths() {
  // Dedicated Hello Interview–style shells
  const dedicated = new Set(['dsa', 'system-design', 'ai-engineering']);
  return categories.filter((c) => !dedicated.has(c.slug)).map((c) => ({ params: { category: c.slug } }));
}

const { category: categorySlug } = Astro.params;
const category = getCategory(categorySlug!);

if (!category) {
  return Astro.redirect('/learn');
}
---

<BaseLayout title={`Learn ${category.title}`} description={category.description}>
  <CourseExplorer client:load category={category} categories={categories} />
</BaseLayout>
