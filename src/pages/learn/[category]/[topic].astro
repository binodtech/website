---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllTopicPaths, getCategory, getTopic } from '@/data/catalog';

export function getStaticPaths() {
  return getAllTopicPaths()
    .filter(({ category, topic }) => {
      const t = getTopic(category, topic);
      if (!t?.isFree) return false;
      // Dedicated full lesson pages
      if (category === 'system-design' && topic === 'fundamentals') return false;
      return true;
    })
    .map(({ category, topic }) => ({ params: { category, topic } }));
}

const { category: categorySlug, topic: topicSlug } = Astro.params;
const category = getCategory(categorySlug!);
const topic = getTopic(categorySlug!, topicSlug!);

if (!category || !topic || !topic.isFree) {
  return Astro.redirect('/pricing');
}
---

<BaseLayout title={topic.title} description={topic.description}>
  <article class="container-wide section-padding">
    <nav class="text-sm text-slate-500">
      <a href="/learn" class="hover:text-brand-600">Study Material</a>
      <span class="mx-2">/</span>
      <a href={`/learn/${category.slug}`} class="hover:text-brand-600">{category.title}</a>
      <span class="mx-2">/</span>
      <span class="text-slate-800 dark:text-slate-200">{topic.title}</span>
    </nav>

    <div class="mt-6 max-w-3xl">
      <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold uppercase text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300">
        Free lesson
      </span>
      <h1 class="mt-4 font-display text-3xl font-bold sm:text-4xl">{topic.title}</h1>
      <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{topic.description}</p>
      <p class="mt-2 text-sm text-slate-500">
        {topic.lessons} lessons · {topic.duration} · {topic.level}
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-6">
        <section class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
          <h2 class="font-display text-xl font-bold">What you'll learn</h2>
          <ul class="mt-4 space-y-2 text-slate-600 dark:text-slate-400">
            <li class="flex gap-2"><span class="text-emerald-500">✓</span> Interview-ready frameworks used in FAANG prep</li>
            <li class="flex gap-2"><span class="text-emerald-500">✓</span> Structured revision sheets with diagrams</li>
            <li class="flex gap-2"><span class="text-emerald-500">✓</span> Practice prompts aligned with video lessons</li>
            <li class="flex gap-2"><span class="text-emerald-500">✓</span> Same depth as premium tracks — this topic is open</li>
          </ul>
        </section>

        <section class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
          <h2 class="font-display text-xl font-bold">Lesson outline</h2>
          <ol class="mt-4 space-y-3">
            {Array.from({ length: topic.lessons }, (_, i) => (
              <li class="flex items-center gap-3 rounded-lg border border-slate-100 px-4 py-3 dark:border-slate-800">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-100 text-xs font-bold text-brand-700 dark:bg-blue-500/20 dark:text-blue-300">
                  {i + 1}
                </span>
                <span class="text-sm font-medium">Module {i + 1} — {topic.title}</span>
              </li>
            ))}
          </ol>
          <p class="mt-4 text-sm text-slate-500">
            Full interactive content ships with Pro. This free lesson confirms the teaching style and depth.
          </p>
        </section>
      </div>

      <aside class="space-y-4">
        <div class="rounded-2xl border border-amber-200 bg-amber-50 p-5 dark:border-amber-500/30 dark:bg-amber-500/10">
          <p class="text-sm font-bold text-amber-900 dark:text-amber-200">Want the full {category.title} track?</p>
          <p class="mt-2 text-sm text-amber-800 dark:text-amber-300/90">
            Unlock {category.topics.filter((t) => !t.isFree).length} premium topics including interview-critical material.
          </p>
          <a href="/pricing" class="mt-4 flex h-10 items-center justify-center rounded-xl bg-amber-600 text-sm font-semibold text-white hover:bg-amber-700">
            Unlock with Pro
          </a>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
          <p class="text-sm font-semibold">Preview on YouTube</p>
          <p class="mt-1 text-xs text-slate-500">Same instructor, same clarity</p>
          <a
            href="https://youtube.com/@binodsuman"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 flex h-10 items-center justify-center rounded-xl border border-slate-200 text-sm font-semibold hover:border-red-300 hover:text-red-600 dark:border-slate-700"
          >
            Watch samples
          </a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
