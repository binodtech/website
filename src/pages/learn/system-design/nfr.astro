---
import LessonPage from '@/components/LessonPage.astro';
import { getCategory } from '@/data/catalog';
import { systemDesignNfr } from '@/data/lessons/system-design-nfr';

const category = getCategory('system-design')!;
---

<LessonPage
  categorySlug="system-design"
  categoryTitle={category.title}
  lesson={systemDesignNfr}
  asideNote="NFRs tie directly to every system design interview — practice applying them on URL Shortener and Rate Limiter next."
  nextLinks={[
    { href: '/learn/system-design/fundamentals', label: 'SD Fundamentals' },
    { href: '/learn/system-design/url-shortener', label: 'URL Shortener' },
    { href: '/learn/system-design/rate-limiter', label: 'Rate Limiter' },
  ]}
/>
