---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCategory, getTopic } from '@/data/catalog';
import { getLesson } from '@/data/lessons';

const categorySlug = 'system-design';
const topicSlug = 'fundamentals';
const category = getCategory(categorySlug);
const topic = getTopic(categorySlug, topicSlug);
const lesson = getLesson(categorySlug, topicSlug);

if (!category || !topic || !topic.isFree || !lesson) {
  return Astro.redirect('/pricing');
}
---

<BaseLayout title={lesson.title} description={lesson.subtitle}>
  <article class="lesson-page">
    <div class="container-wide section-padding">
      <nav class="text-sm text-slate-500">
        <a href="/learn" class="hover:text-brand-600">Study Material</a>
        <span class="mx-2">/</span>
        <a href={`/learn/${category.slug}`} class="hover:text-brand-600">{category.title}</a>
        <span class="mx-2">/</span>
        <span class="text-slate-800 dark:text-slate-200">{lesson.title}</span>
      </nav>

      <header class="mt-6 max-w-3xl">
        <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-bold uppercase text-emerald-800 dark:bg-emerald-500/20 dark:text-emerald-300">
          Free · Full lesson
        </span>
        <h1 class="mt-4 font-display text-3xl font-bold sm:text-4xl">{lesson.title}</h1>
        <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{lesson.subtitle}</p>
      </header>

      <div class="lesson-tip mt-6 max-w-4xl">
        <strong>Interview tip:</strong> {lesson.interviewTip}
      </div>

      {lesson.video && (
        <div class="mt-8 max-w-4xl overflow-hidden rounded-2xl border border-slate-200 bg-black shadow-xl dark:border-slate-700">
          <div class="aspect-video">
            <iframe
              title={lesson.video.title}
              src={`https://www.youtube-nocookie.com/embed/${lesson.video.id}?rel=0`}
              class="h-full w-full"
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
          <p class="border-t border-slate-800 bg-slate-900 px-4 py-3 text-sm text-slate-300">
            Related video: {lesson.video.title}
          </p>
        </div>
      )}

      <nav class="lesson-toc mt-10 max-w-4xl" aria-label="On this page">
        <p class="text-xs font-bold uppercase tracking-wide text-slate-500">On this page</p>
        <ol class="mt-3 grid gap-1 sm:grid-cols-2">
          {lesson.sections.map((s) => (
            <li>
              <a href={`#${s.id}`} class="text-sm text-brand-600 hover:underline dark:text-blue-400">
                {s.title}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      <div class="lesson-body mt-10 max-w-4xl space-y-8">
        {lesson.sections.map((section) => (
          <section id={section.id} class="lesson-section rounded-2xl border border-slate-200 bg-white p-6 sm:p-8 dark:border-slate-800 dark:bg-slate-900">
            <h2 class="font-display text-xl font-bold text-slate-900 dark:text-white">{section.title}</h2>
            <div class="lesson-prose mt-4" set:html={section.html} />
          </section>
        ))}
      </div>

      <aside class="mt-10 max-w-4xl rounded-2xl border border-amber-200 bg-amber-50 p-6 dark:border-amber-500/30 dark:bg-amber-500/10">
        <p class="font-bold text-amber-900 dark:text-amber-200">Next in System Design</p>
        <p class="mt-2 text-sm text-amber-800 dark:text-amber-300/90">
          Practice with URL Shortener and Rate Limiter (free), or unlock ChatGPT system design, 31 core concepts, and Google SD collection with Pro.
        </p>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href="/learn/system-design/url-shortener" class="rounded-xl bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700">
            URL Shortener (free)
          </a>
          <a href="/learn/system-design/rate-limiter" class="rounded-xl border border-amber-300 px-4 py-2 text-sm font-semibold hover:bg-amber-100 dark:border-amber-600">
            Rate Limiter (free)
          </a>
          <a href="/pricing" class="rounded-xl border border-amber-300 px-4 py-2 text-sm font-semibold hover:bg-amber-100 dark:border-amber-600">
            Unlock Pro tracks
          </a>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .lesson-tip {
    border-radius: 0.75rem;
    border: 1px solid #bfdbfe;
    background: #eff6ff;
    padding: 1rem 1.25rem;
    font-size: 0.875rem;
    color: #1e3a8a;
  }
  :global(.dark) .lesson-tip {
    border-color: rgba(59, 130, 246, 0.3);
    background: rgba(59, 130, 246, 0.1);
    color: #dbeafe;
  }
  .lesson-prose :global(p) {
    margin-top: 0.75rem;
    line-height: 1.625;
    color: #475569;
  }
  :global(.dark) .lesson-prose :global(p) {
    color: #cbd5e1;
  }
  .lesson-prose :global(ul),
  .lesson-prose :global(ol) {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    color: #475569;
  }
  .lesson-prose :global(ul) {
    list-style-type: disc;
  }
  .lesson-prose :global(ol) {
    list-style-type: decimal;
  }
  :global(.dark) .lesson-prose :global(ul),
  :global(.dark) .lesson-prose :global(ol) {
    color: #cbd5e1;
  }
  .lesson-prose :global(table) {
    margin-top: 1rem;
    width: 100%;
    text-align: left;
    font-size: 0.875rem;
  }
  .lesson-prose :global(th) {
    border-bottom: 1px solid #e2e8f0;
    background: #f8fafc;
    padding: 0.5rem 0.75rem;
    font-weight: 600;
  }
  :global(.dark) .lesson-prose :global(th) {
    border-color: #334155;
    background: #1e293b;
  }
  .lesson-prose :global(td) {
    border-bottom: 1px solid #f1f5f9;
    padding: 0.5rem 0.75rem;
  }
  :global(.dark) .lesson-prose :global(td) {
    border-color: #1e293b;
  }
  .lesson-prose :global(code) {
    border-radius: 0.25rem;
    background: #f1f5f9;
    padding: 0.125rem 0.375rem;
    font-size: 0.875rem;
  }
  :global(.dark) .lesson-prose :global(code) {
    background: #1e293b;
  }
  .lesson-prose :global(.lesson-callout) {
    margin-top: 1rem;
    border-radius: 0.5rem;
    border: 1px solid #ddd6fe;
    background: #f5f3ff;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    color: #4c1d95;
  }
  :global(.dark) .lesson-prose :global(.lesson-callout) {
    border-color: rgba(139, 92, 246, 0.3);
    background: rgba(139, 92, 246, 0.1);
    color: #ede9fe;
  }
  .lesson-prose :global(.lesson-flow) {
    margin-top: 1rem;
    border-radius: 0.5rem;
    background: #f1f5f9;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #334155;
  }
  :global(.dark) .lesson-prose :global(.lesson-flow) {
    background: #1e293b;
    color: #e2e8f0;
  }
  .lesson-prose :global(.lesson-layers) {
    margin-top: 1rem;
    list-style-type: decimal;
    padding-left: 1.25rem;
  }
  .lesson-prose :global(.lesson-checklist) {
    margin-top: 1rem;
    list-style: none;
    padding-left: 0;
  }
  .lesson-prose :global(.lesson-checklist li) {
    display: flex;
    gap: 0.5rem;
  }
  .lesson-prose :global(.lesson-checklist li)::before {
    content: '✓';
    color: #10b981;
    font-weight: 700;
  }
</style>
