---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { StudyCatalog } from '@/components/react/StudyCatalog';
import { categories, countTopics } from '@/data/catalog';
---

<BaseLayout title="Study Material" description="Interactive study library — free starters in every category, premium tracks for interview mastery.">
  <section class="border-b border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900/50">
    <div class="container-wide section-padding !pb-10">
      <p class="text-sm font-semibold text-brand-600 dark:text-blue-400">Study library</p>
      <h1 class="mt-2 font-display text-3xl font-bold sm:text-4xl">Learn like Educative — prep like Hello Interview</h1>
      <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-400">
        Browse structured tracks with free starter lessons in every category. Premium topics unlock the full interview library, Google SD collection, and AI tools.
      </p>
      <dl class="mt-8 flex flex-wrap gap-6">
        <div>
          <dt class="text-2xl font-bold">{countTopics().total}</dt>
          <dd class="text-xs text-slate-500">Total topics</dd>
        </div>
        <div>
          <dt class="text-2xl font-bold text-emerald-600">{countTopics().free}</dt>
          <dd class="text-xs text-slate-500">Free starters</dd>
        </div>
        <div>
          <dt class="text-2xl font-bold text-amber-600">{countTopics().premium}</dt>
          <dd class="text-xs text-slate-500">Premium topics</dd>
        </div>
        <div>
          <dt class="text-2xl font-bold">{categories.length}</dt>
          <dd class="text-xs text-slate-500">Learning tracks</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-wide">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="font-display text-xl font-bold">All categories</h2>
          <p class="mt-1 text-sm text-slate-500">🔓 Free lessons open to everyone · 🔒 Pro unlocks interview-critical topics</p>
        </div>
        <a href="/pricing" class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700">
          Unlock full library
        </a>
      </div>
      <StudyCatalog client:load />
    </div>
  </section>
</BaseLayout>
