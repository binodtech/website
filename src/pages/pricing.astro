---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { pricingPlans } from '@/data/content';
import { categories } from '@/data/catalog';
---

<BaseLayout title="Pricing" description="Unlock the full Binod Suman Academy library — Pro subscription or live cohort.">
  <section class="section-padding">
    <div class="container-wide text-center">
      <h1 class="font-display text-3xl font-bold sm:text-4xl">Unlock interview mastery</h1>
      <p class="mt-3 text-slate-600 dark:text-slate-400">
        Free starters in every category. Pro unlocks Google SD, core concepts, mocks, and AI tools.
      </p>
    </div>

    <div class="container-wide mt-12 grid gap-6 lg:grid-cols-3">
      {pricingPlans.map((plan) => (
        <div
          class:list={[
            'rounded-2xl border p-6',
            plan.highlighted
              ? 'border-brand-500 bg-brand-50 shadow-xl shadow-brand-500/10 dark:border-blue-500 dark:bg-blue-500/10'
              : 'border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900',
          ]}
        >
          {plan.highlighted && (
            <span class="rounded-full bg-brand-600 px-3 py-0.5 text-xs font-bold text-white">Most popular</span>
          )}
          <h2 class="mt-2 font-display text-xl font-bold">{plan.name}</h2>
          <p class="mt-1 text-sm text-slate-500">{plan.description}</p>
          <p class="mt-4 font-display text-4xl font-bold">
            {plan.price}
            <span class="text-base font-normal text-slate-500">{plan.period}</span>
          </p>
          <ul class="mt-6 space-y-2 text-sm text-slate-600 dark:text-slate-400">
            {plan.features.map((f) => (
              <li class="flex gap-2"><span class="text-emerald-500">✓</span> {f}</li>
            ))}
          </ul>
          <a
            href={plan.href}
            class:list={[
              'mt-6 flex h-11 items-center justify-center rounded-xl text-sm font-semibold transition',
              plan.highlighted
                ? 'bg-brand-600 text-white hover:bg-brand-700'
                : 'border border-slate-200 hover:border-brand-300 dark:border-slate-700',
            ]}
          >
            {plan.cta}
          </a>
        </div>
      ))}
    </div>

    <div class="container-wide mt-16">
      <h2 class="font-display text-2xl font-bold">What Pro unlocks</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categories.flatMap((c) =>
          c.topics.filter((t) => !t.isFree).slice(0, 2).map((t) => (
            <div class="rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
              <p class="text-xs font-semibold text-amber-600 dark:text-amber-400">{c.title}</p>
              <p class="mt-1 font-semibold">{t.title}</p>
              <p class="mt-1 text-xs text-slate-500 line-clamp-2">{t.description}</p>
            </div>
          ))
        )}
      </div>
      <p class="mt-8 text-center text-sm text-slate-500">
        Payments via Razorpay — coming soon. Join the waitlist by emailing hello@binodsumanacademy.com
      </p>
    </div>
  </section>
</BaseLayout>
