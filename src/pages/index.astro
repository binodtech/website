---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { HeroDashboard } from '@/components/react/HeroDashboard';
import { SearchSection } from '@/components/react/SearchSection';
import { YouTubeShowcase } from '@/components/react/YouTubeShowcase';
import {
  trustLogos,
  learningPaths,
  popularCourses,
  interviewHub,
  companyPrep,
  aiFeatures,
  projects,
  stats,
} from '@/data/content';
import { SITE } from '@/lib/utils';
---

<BaseLayout>
  <!-- Hero — original premium layout, refined -->
  <section class="relative overflow-hidden section-padding pb-8 lg:pb-16">
    <div class="glow-orb -left-32 top-0 h-96 w-96 bg-blue-500/30" aria-hidden="true" />
    <div class="glow-orb -right-32 top-20 h-80 w-80 bg-violet-500/25" aria-hidden="true" />
    <div class="container-wide relative grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <div class="mb-4 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700 dark:border-blue-500/30 dark:bg-blue-500/10 dark:text-blue-300">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-pulse" />
          Free starters in every track · Premium interview library
        </div>
        <h1 class="font-display text-4xl font-bold leading-tight tracking-tight text-slate-900 sm:text-5xl lg:text-[3.25rem] dark:text-white">
          Master skills that <span class="gradient-text">top tech companies</span> actually hire for
        </h1>
        <p class="mt-5 text-lg text-slate-600 dark:text-slate-300">
          From DSA and System Design to AI Engineering and cloud architecture — structured paths, interview prep, and architect-led lessons built for serious candidates.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/learn"
            class="inline-flex h-12 items-center rounded-xl bg-brand-600 px-6 text-sm font-semibold text-white shadow-lg shadow-brand-600/30 transition hover:bg-brand-700"
          >
            Start Learning Free
          </a>
          <a
            href="#courses"
            class="inline-flex h-12 items-center rounded-xl border border-slate-200 bg-white px-6 text-sm font-semibold text-slate-800 transition hover:border-brand-300 dark:border-slate-700 dark:bg-slate-900 dark:text-white"
          >
            Explore Courses
          </a>
        </div>
        <dl class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {stats.map((s) => (
            <div>
              <dt class="font-display text-2xl font-bold text-slate-900 dark:text-white">{s.value}</dt>
              <dd class="text-xs text-slate-500 dark:text-slate-400">{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="lg:pl-4">
        <HeroDashboard client:load />
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="border-y border-slate-200 bg-white py-10 dark:border-slate-800 dark:bg-slate-900/50">
    <div class="container-wide px-4 text-center sm:px-6 lg:px-8">
      <p class="text-sm font-medium text-slate-500 dark:text-slate-400">
        Learners prepare for opportunities at the world's leading technology companies
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-10 gap-y-4">
        {trustLogos.map((logo) => (
          <span class="font-display text-lg font-semibold text-slate-400 dark:text-slate-500">{logo}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- YouTube Quality Showcase -->
  <section class="section-padding bg-slate-100/80 dark:bg-slate-900/30" id="youtube">
    <div class="container-wide">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-bold">Preview the teaching quality</h2>
        <p class="mt-2 text-slate-600 dark:text-slate-400">
          Watch free samples on YouTube — same clarity and depth you'll find across the full academy library.
        </p>
      </div>
      <div class="mt-10">
        <YouTubeShowcase client:load />
      </div>
    </div>
  </section>

  <!-- Search -->
  <section class="section-padding" id="search">
    <div class="container-wide">
      <h2 class="text-center font-display text-2xl font-bold sm:text-3xl">Find what you need to learn</h2>
      <p class="mt-2 text-center text-slate-600 dark:text-slate-400">
        Search the library — <span class="text-emerald-600 dark:text-emerald-400">free</span> topics open instantly, <span class="text-amber-600 dark:text-amber-400">Pro</span> unlocks interview-critical material
      </p>
      <div class="mt-8">
        <SearchSection client:load />
      </div>
    </div>
  </section>

  <!-- Learning Paths -->
  <section class="section-padding bg-slate-100/80 dark:bg-slate-900/30" id="paths">
    <div class="container-wide">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-bold">Featured learning paths</h2>
        <p class="mt-2 text-slate-600 dark:text-slate-400">Curated roadmaps — free starters in every track</p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {learningPaths.map((path) => (
          <a
            href={path.href}
            class="card-hover group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900"
          >
            <div class={`mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br ${path.color} text-white shadow-lg`}>
              <span class="text-lg font-bold">{path.title.charAt(0)}</span>
            </div>
            <h3 class="font-display text-xl font-bold group-hover:text-brand-600 dark:group-hover:text-blue-400">{path.title}</h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{path.description}</p>
            <p class="mt-3 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
              {path.freeCount} free · {path.totalCount} total topics
            </p>
            <ul class="mt-3 flex flex-wrap gap-2">
              {path.topics.map((t) => (
                <li class="rounded-md bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-300">{t}</li>
              ))}
            </ul>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Popular Courses -->
  <section class="section-padding" id="courses">
    <div class="container-wide">
      <h2 class="font-display text-3xl font-bold">Most popular courses</h2>
      <p class="mt-2 text-slate-600 dark:text-slate-400">Start with free lessons — unlock Pro for Google SD, mocks, and advanced tracks</p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {popularCourses.map((course) => (
          <a href={course.href} class="card-hover group relative flex flex-col rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
            {course.badge && (
              <span class="absolute right-4 top-4 rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-amber-800 dark:bg-amber-500/20 dark:text-amber-300">
                {course.badge}
              </span>
            )}
            <h3 class="font-display text-lg font-bold group-hover:text-brand-600 dark:group-hover:text-blue-400">{course.title}</h3>
            <p class="mt-1 text-sm text-slate-500">{course.subtitle}</p>
            <div class="mt-4 flex items-center gap-3 text-xs text-slate-500">
              <span>★ {course.rating}</span>
              <span>{course.students} learners</span>
              <span>{course.duration}</span>
            </div>
            <div class="mt-3 flex flex-wrap gap-2 text-xs">
              <span class="rounded-md bg-slate-100 px-2 py-1 dark:bg-slate-800">{course.lessons} lessons</span>
              <span class="rounded-md bg-slate-100 px-2 py-1 dark:bg-slate-800">{course.level}</span>
              {course.premium && (
                <span class="rounded-md bg-amber-100 px-2 py-1 text-amber-800 dark:bg-amber-500/20 dark:text-amber-300">Pro</span>
              )}
            </div>
            <p class="mt-4 text-xs text-slate-400">Instructor: {course.instructor}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Interview Hub -->
  <section class="section-padding bg-slate-100/80 dark:bg-slate-900/30" id="interview-hub">
    <div class="container-wide">
      <h2 class="font-display text-3xl font-bold">Interview preparation hub</h2>
      <p class="mt-2 text-slate-600 dark:text-slate-400">Coding, system design, behavioral, AI rounds — one place</p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {interviewHub.map((item) => (
          <a
            href={item.href}
            class="card-hover rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900"
          >
            <h3 class="font-display font-bold text-brand-600 dark:text-blue-400">{item.title}</h3>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-400">{item.desc}</p>
          </a>
        ))}
      </div>
      <div class="mt-8">
        <p class="text-sm font-semibold text-slate-700 dark:text-slate-300">Company-specific prep (Pro)</p>
        <div class="mt-3 flex flex-wrap gap-2">
          {companyPrep.map((c) => (
            <a
              href={c.href}
              class="rounded-lg border border-slate-200 bg-white px-4 py-2 text-sm font-medium transition hover:border-brand-300 hover:text-brand-600 dark:border-slate-700 dark:bg-slate-900"
            >
              {c.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- AI Assistant -->
  <section class="section-padding bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white">
    <div class="container-wide">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="font-display text-3xl font-bold">AI-powered learning assistant</h2>
          <p class="mt-3 text-slate-300">
            Tutor, mock interviewer, roadmap generator, and resume feedback — built into Pro and Cohort plans.
          </p>
          <a href="/pricing" class="mt-6 inline-flex rounded-xl bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">
            Unlock AI tools
          </a>
        </div>
        <div class="grid gap-3 sm:grid-cols-2">
          {aiFeatures.map((f) => (
            <div class="rounded-xl border border-white/10 bg-white/5 p-4 backdrop-blur">
              <p class="font-semibold">{f.title}</p>
              <p class="mt-1 text-xs text-slate-400">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="section-padding" id="projects">
    <div class="container-wide">
      <h2 class="font-display text-3xl font-bold">Hands-on projects</h2>
      <p class="mt-2 text-slate-600 dark:text-slate-400">Build production-style systems — not just theory</p>
      <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {projects.map((p) => (
          <a href={p.href} class="card-hover rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
            <h3 class="font-display font-bold">{p.title}</h3>
            <p class="mt-2 text-xs text-slate-500">{p.stack}</p>
            <div class="mt-3 flex gap-2 text-xs">
              <span class="rounded bg-slate-100 px-2 py-0.5 dark:bg-slate-800">{p.level}</span>
              <span class="text-slate-500">{p.hours}h</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding">
    <div class="container-wide">
      <div class="rounded-3xl bg-gradient-to-r from-brand-600 to-violet-600 p-8 text-center text-white sm:p-12">
        <h2 class="font-display text-3xl font-bold">Ready to transform your career?</h2>
        <p class="mt-3 text-blue-100">Start with free lessons in every category — upgrade when you're ready for mocks and premium tracks.</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/learn" class="rounded-xl bg-white px-6 py-3 text-sm font-semibold text-brand-700 hover:bg-blue-50">
            Start Learning Free
          </a>
          <a href={SITE.youtubeUrl} target="_blank" rel="noopener noreferrer" class="rounded-xl border border-white/30 px-6 py-3 text-sm font-semibold hover:bg-white/10">
            Watch on YouTube
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
